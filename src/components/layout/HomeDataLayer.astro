---
import { Picture } from "astro:assets";
import networkImage from "@/assets/images/professional/network-operations.webp";
import opticImage from "@/assets/images/professional/optic-module.webp";
import serverImage from "@/assets/images/professional/server-racks.webp";
import toolchainImage from "@/assets/images/professional/engineering-toolchain.webp";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const allPosts = await getSortedPosts();
const posts = allPosts.filter(
	(post) =>
		!post.data.draft && new Date(post.data.published).getFullYear() >= 2000,
);
const categoryCount = new Set(
	posts.map((post) => post.data.category).filter(Boolean),
).size;
const tagCount = new Set(posts.flatMap((post) => post.data.tags || [])).size;

const totalWords = posts.reduce((sum, post) => {
	const text = (post.body || "")
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
	const latinWords = text.match(/[a-zA-Z]+/g) || [];
	return sum + chineseChars.length + latinWords.length;
}, 0);

const formatCompact = (value: number) => {
	if (value >= 1000) return `${(value / 1000).toFixed(1)}k`;
	return String(value);
};

const infrastructure = [
	{
		logo: "/assets/images/logos/transparent/cisco.png",
		label: "Cisco",
		visualWidth: 66,
		visualHeight: 40,
	},
	{
		logo: "/assets/images/logos/transparent/huawei.png",
		label: "HUAWEI",
		visualWidth: 60,
		visualHeight: 44,
	},
	{
		logo: "/assets/images/logos/transparent/h3c.png",
		label: "H3C",
		visualWidth: 76,
		visualHeight: 35,
	},
	{
		logo: "/assets/images/logos/transparent/fortigate.png",
		label: "Fortigate",
		visualWidth: 64,
		visualHeight: 41,
	},
	{
		logo: "/assets/images/logos/transparent/hillstone.png",
		label: "Hillstone",
		visualWidth: 76,
		visualHeight: 35,
	},
	{
		logo: "/assets/images/logos/transparent/nvidia.png",
		label: "Nvidia",
		visualWidth: 60,
		visualHeight: 44,
	},
];

const skills = [
	{ logo: "/assets/images/logos/transparent/git.png", label: "Git" },
	{ logo: "/assets/images/logos/transparent/cacti.png", label: "Cacti" },
	{ logo: "/assets/images/logos/transparent/linux.png", label: "Linux" },
	{ logo: "/assets/images/logos/transparent/netbox.png", label: "Netbox" },
	{ logo: "/assets/images/logos/transparent/zabbix.png", label: "Zabbix" },
	{ logo: "/assets/images/logos/transparent/python.png", label: "Python" },
	{ logo: "/assets/images/logos/transparent/grafana.png", label: "Grafana" },
	{
		logo: "/assets/images/logos/transparent/prometheus.png",
		label: "Prometheus",
	},
	{
		logo: "/assets/images/logos/transparent/elasticsearch.png",
		label: "Elasticsearch",
	},
];
---

<section class="home-data-layer" id="data-matrix" aria-labelledby="data-matrix-title">
	<header class="home-data-layer__heading">
		<div class="home-data-layer__heading-copy">
			<h2 id="data-matrix-title" data-lang-en="Field Notes" data-lang-zh="现场笔记">Field Notes</h2>
		</div>
	</header>

	<div class="home-data-layer__matrix">
		<a class="data-metric-card data-metric-card--journal" href={url("/posts/")}>
			<Picture
				class="data-metric-card__image"
				src={networkImage}
				alt=""
				formats={["avif", "webp"]}
				widths={[480, 760]}
				sizes="(max-width: 800px) 100vw, 34vw"
				loading="lazy"
			/>
			<div class="data-metric-card__wash"></div>
			<div class="data-metric-card__content">
				<span>JOURNAL</span>
				<h3 data-lang-en="Production Notes" data-lang-zh="生产网络笔记">Production Notes</h3>
				<p data-lang-en="Routing / incidents / data center" data-lang-zh="路由 / 故障 / 数据中心">Routing / incidents / data center</p>
			</div>
		</a>

		<a class="data-metric-card data-metric-card--archive" href={url("/archive/")}>
			<Picture
				class="data-metric-card__image data-metric-card__image--right"
				src={serverImage}
				alt=""
				formats={["avif", "webp"]}
				widths={[720, 1280]}
				sizes="(max-width: 800px) 100vw, 62vw"
				loading="lazy"
			/>
			<div class="data-metric-card__wash"></div>
			<div class="data-metric-card__content">
				<span>ARCHIVE</span>
				<h3 data-lang-en="Article Archive" data-lang-zh="文章档案">Article Archive</h3>
				<p>
					<strong>{posts.length}</strong> <span data-lang-en="posts" data-lang-zh="篇文章">posts</span> /
					<strong>{categoryCount}</strong> <span data-lang-en="categories" data-lang-zh="个分类">categories</span> /
					<strong>{tagCount}</strong> <span data-lang-en="tags" data-lang-zh="个标签">tags</span>
				</p>
			</div>
		</a>

	<div class="data-band data-band--network">
		<Picture
			class="data-band__image"
			src={opticImage}
			alt=""
			formats={["avif", "webp"]}
			widths={[520, 860]}
			sizes="(max-width: 800px) 100vw, 36vw"
			loading="lazy"
		/>
		<div class="data-band__intro">
			<span>INFRASTRUCTURE</span>
			<h3 data-lang-en="Network Stack" data-lang-zh="网络技术栈">Network Stack</h3>
			<p data-lang-en="From the access layer to the edge, every path should remain observable, explainable, and recoverable." data-lang-zh="从接入层到网络边缘，让每一条路径都可观测、可解释、可恢复。">From the access layer to the edge, every path should remain observable, explainable, and recoverable.</p>
		</div>
		<div class="matrix-loop" aria-label="Network infrastructure" data-lang-aria-en="Network infrastructure" data-lang-aria-zh="网络基础设施">
			<div class="matrix-loop__track">
				{[...infrastructure, ...infrastructure].map((item, index) => (
					<span
						class="matrix-loop__logo-item matrix-loop__logo-item--brand"
						title={item.label}
						aria-hidden={index >= infrastructure.length ? "true" : undefined}
					>
						<img
							class="matrix-loop__logo"
							src={item.logo}
							alt=""
							width="112"
							height="64"
							loading="lazy"
							decoding="async"
							style={`--brand-logo-width:${item.visualWidth}px;--brand-logo-height:${item.visualHeight}px`}
						/>
						<small>{item.label}</small>
					</span>
				))}
			</div>
		</div>
	</div>

	<div class="data-band data-band--skills">
		<Picture
			class="data-band__image"
			src={toolchainImage}
			alt=""
			formats={["avif", "webp"]}
			widths={[520, 860]}
			sizes="(max-width: 800px) 100vw, 36vw"
			loading="lazy"
		/>
		<div class="data-band__intro">
			<span>TOOLCHAIN</span>
			<h3 data-lang-en="Engineering Tools" data-lang-zh="工程工具链">Engineering Tools</h3>
			<p data-lang-en="Networking, systems, automation, and observability tools share one verification-first workflow." data-lang-zh="网络、系统、自动化与可观测工具，共用一套验证优先的工程流程。">Networking, systems, automation, and observability tools share one verification-first workflow.</p>
		</div>
		<div class="matrix-loop matrix-loop--skills" aria-label="Engineering tools" data-lang-aria-en="Engineering tools" data-lang-aria-zh="工程工具">
			<div class="matrix-loop__track matrix-loop__track--reverse">
				{[...skills, ...skills].map((item, index) => (
					<span
						class="matrix-loop__logo-item matrix-loop__logo-item--skill"
						title={item.label}
						aria-hidden={index >= skills.length ? "true" : undefined}
					>
						<img
							class="matrix-loop__logo"
							src={item.logo}
							alt=""
							width="64"
							height="64"
							loading="lazy"
							decoding="async"
						/>
						<small>{item.label}</small>
					</span>
				))}
			</div>
		</div>
	</div>
	</div>

	<footer class="home-data-layer__foot">
		<span>LOCAL CONTENT INDEX</span>
		<span>{formatCompact(totalWords)} WORDS</span>
		<span>UPDATED WITH EACH BUILD</span>
	</footer>
</section>
